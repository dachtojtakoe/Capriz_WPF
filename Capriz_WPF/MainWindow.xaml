                <TextBlock x:Name="lblDateTimeText"  Text="Укажите пожалуйста диапазон дат для отображения данных" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Top" FontSize="14pt" Foreground="White" FontWeight="Bold" Width="319" Height="50" FontFamily="Microsoft Sans Serif" Margin="0,10,0,0"/>

                <Button x:Name="btn6H" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="6ч" Click="btn6H_Click" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="47,65,0,0" Cursor="Hand" />
                <Button x:Name="btn1D" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="1д" Click="btn1D_Click" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="112,65,0,0" Cursor="Hand" />
                <Button x:Name="btn7D" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="7д" Click="btn7D_Click" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="178,65,0,0" Cursor="Hand" />
                <Button x:Name="btn1M" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="1мес" Click="btn1M_Click" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="247,65,0,0" Cursor="Hand" />

                <Label Content="От:" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14pt" Foreground="White" FontWeight="Bold" FontFamily="Microsoft Sans Serif" Margin="0,0,200,0"/>
                <Label Content="До:" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14pt" Foreground="White" FontWeight="Bold" FontFamily="Microsoft Sans Serif" Margin="0,110,200,0"/>
                <CustomControls:CustomButtonText x:Name="btnDateFrom" HorizontalAlignment="Center" Width="200" Height="40" VerticalAlignment="Center" BtnText="04.07.2024 15:35:33" Margin="40,0,0,0" CommandText="{StaticResource btnDateFrom_Click}" Cursor="Hand"/>
                <CustomControls:CustomButtonText x:Name="btnDateTo" HorizontalAlignment="Center" Width="200" Height="40" VerticalAlignment="Center" BtnText="04.07.2024 15:35:33" Margin="40,110,0,0" CommandText="{StaticResource btnDateTo_Click}" Cursor="Hand"/>

                <CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Применить" Margin="0,0,130,10" CommandText="{StaticResource btnApprove_Click}" Cursor="Hand"/>
                <CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Отмена" Margin="130,0,0,10" CommandText="{StaticResource btnCancel_Click}" Cursor="Hand"/>
            </Grid>
        </ItemsControl>

        <CustomControls:CustomCalendar x:Name="customCalendar1" Height="470" Width="350" Visibility="Hidden" />

        <ItemsControl x:Name="panelCustomGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Template="{StaticResource ItemsControlTemplateSolidBackground}" Height="549" Width="750" Visibility="Hidden">
            <CustomControls:CustomGridOld x:Name="customGrid1" VerticalAlignment="Top" Height="530" Width="737" HorizontalAlignment="Left" Visibility="Visible" Margin="5,5,0,5"/>
