                <CustomControls:CustomButtonText x:Name="StationHeight" HorizontalAlignment="Center" Width="120" Height="40" IsEnabled="False" VerticalAlignment="Center" BtnText="0 м" Margin="0,0,0,0" CommandText="{StaticResource btnApprovePresModif_Click}" Cursor="Hand"/>
                <Button x:Name="odd1m" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="-1" Click="odd1m_Click" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,320,0" Cursor="Hand" />
                <Button x:Name="odd01m" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="-0.1" Click="odd01m_Click" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,200,0" Cursor="Hand" />
                <Button x:Name="add01m" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="+0.1" Click="add01m_Click" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,0,0,0" Cursor="Hand" />
                <Button x:Name="add1m" Template="{StaticResource CustomButtonTemplate}" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="16"  Content="+1" Click="add1m_Click" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="320,0,0,0" Cursor="Hand" />

                <!--<CheckBox x:Name="SeeLevelPresCheck" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,85,0,0" Content="Приводить давление к уровню моря" Style="{StaticResource CheckboxStyle}"/>-->

                <CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Применить" Margin="150,0,0,10" CommandText="{StaticResource btnApprovePresModif_Click}" Cursor="Hand"/>
                <CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Отмена" Margin="0,0,150,10" CommandText="{StaticResource btnCancelPresModif_Click}" Cursor="Hand"/>
            </Grid>
        </ItemsControl>

        <ItemsControl x:Name="panelSetNavigation" HorizontalAlignment="Center" VerticalAlignment="Center" Template="{StaticResource ItemsControlTemplate}" Height="220" Width="350" Visibility="Hidden">
            <Grid Height="220">
                <TextBlock Text="Выберите источник навигации" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Top" FontSize="14pt" Foreground="White" FontWeight="Bold" Width="319" Height="50" FontFamily="Microsoft Sans Serif" Margin="0,20,0,0"/>


                <RadioButton x:Name="GPSRB" Content="GPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,90,20" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="14" Cursor="Hand">
                    <RadioButton.RenderTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2"/>
                    </RadioButton.RenderTransform>
                </RadioButton>

                <RadioButton x:Name="LAGRB" Content="LAG" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,20" FontFamily="Microsoft Sans Serif" FontWeight="Bold" Foreground="AliceBlue" FontSize="14" Cursor="Hand">
                    <RadioButton.RenderTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2"/>
                    </RadioButton.RenderTransform>
                </RadioButton>

                <CustomControls:CustomButtonText HorizontalAlignment="Center"  VerticalAlignment="Bottom" Margin="20" CommandText="{StaticResource btnSetNavigationOk_Click}" Cursor="Hand" Width="50" Height="40"/>

                <!--<CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Применить" Margin="150,0,0,10" CommandText="{StaticResource btnApprovePresModif_Click}" Cursor="Hand"/>-->
                <!--<CustomControls:CustomButtonText HorizontalAlignment="Center" Width="120" Height="40" VerticalAlignment="Bottom" BtnText="Отмена" Margin="0,0,150,10" CommandText="{StaticResource btnCancelPresModif_Click}" Cursor="Hand"/>-->
            </Grid>
        </ItemsControl>
    </Grid>
</Window>
