<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capriz_WPF"
        xmlns:CustomControls="clr-namespace:Capriz_WPF.CustomControls" x:Class="Capriz_WPF.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Loaded="Window_Loaded" ResizeMode="NoResize" >

    <Window.Resources>
        <BitmapImage x:Key="sett1" UriSource="/Resources/sett1.png"/>
        <BitmapImage x:Key="search1" UriSource="/Resources/search1.png"/>
        <BitmapImage x:Key="usb2" UriSource="/Resources/usb2.png"/>
        <BitmapImage x:Key="jrnl1" UriSource="/Resources/jrnl1.png"/>
        <BitmapImage x:Key="temp1" UriSource="/Resources/temp1.png"/>
        <BitmapImage x:Key="hum1" UriSource="/Resources/hum11.png"/>
        <BitmapImage x:Key="press1" UriSource="/Resources/press1.png"/>
        <BitmapImage x:Key="Wind1" UriSource="/Resources/speedWind1.png"/>
        <BitmapImage x:Key="vis1" UriSource="/Resources/vis1.png"/>
        <BitmapImage x:Key="terminal2" UriSource="/Resources/terminal2.png"/>
        <BitmapImage x:Key="print31" UriSource="/Resources/print31.png"/>
        <BitmapImage x:Key="info21" UriSource="/Resources/info21.png"/>

        <BitmapImage x:Key="saveChart" UriSource="/Resources/SaveChart.png"/>


        <RoutedCommand x:Key="btnTablo_Click"/>
        <RoutedCommand x:Key="btnOpen_Click"/>
        <RoutedCommand x:Key="btnSave_Click"/>
        <RoutedCommand x:Key="btnGrid_Click"/>
        <RoutedCommand x:Key="btnChT_Click"/>
        <RoutedCommand x:Key="btnChH_Click"/>
        <RoutedCommand x:Key="btnChP_Click"/>
        <RoutedCommand x:Key="btnChW_Click"/>
        <RoutedCommand x:Key="btnChOp_Click"/>
        <RoutedCommand x:Key="btn_Click"/>
        <RoutedCommand x:Key="btnPrint_Click"/>
        <RoutedCommand x:Key="btnVers_Click"/>

        <RoutedCommand x:Key="btnOk_Click"/>
        <RoutedCommand x:Key="btnSetOk_Click"/>
        <RoutedCommand x:Key="btnSetNavigationOk_Click"/>

        <RoutedCommand x:Key="btnSetPresModif_Click"/>
        <RoutedCommand x:Key="btnSetNavigation_Click"/>
        <RoutedCommand x:Key="btnApprovePresModif_Click"/>
        <RoutedCommand x:Key="btnCancelPresModif_Click"/>

        <RoutedCommand x:Key="btnDateFrom_Click"/>
        <RoutedCommand x:Key="btnDateTo_Click"/>

        <RoutedCommand x:Key="btnlblDateFrom_Click"/>
        <RoutedCommand x:Key="btnlblDateTo_Click"/>

        <RoutedCommand x:Key="btnCancel_Click"/>
        <RoutedCommand x:Key="btnApprove_Click"/>

        <Style x:Key="CustomButtonStyle" TargetType="CustomControls:CustomButton">
            <EventSetter Event="MouseEnter" Handler="CustomButton_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="CustomButton_MouseLeave"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>



        <ControlTemplate x:Key="ItemsControlTemplate">
            <Border BorderThickness="3" CornerRadius="10" Margin="0,1,0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF1E465B"/>
                            <GradientStop Offset="1" Color="#FF3D6087"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF3D6087"/>
                            <GradientStop Offset="1" Color="#FF002852"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.Background>
                <ItemsPresenter/>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="ItemsControlTemplate2">
            <Border BorderThickness="3" CornerRadius="10" Margin="0,1,0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF1E465B"/>
                            <GradientStop Offset="1" Color="#FF3D6087"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#0d345d"/>
                </Border.Background>
                <ItemsPresenter/>
            </Border>
        </ControlTemplate>


        <ControlTemplate x:Key="ItemsControlTemplateSolidBackground">
            <Border BorderThickness="3" CornerRadius="10" Margin="0,1,0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF1E465B"/>
                            <GradientStop Offset="1" Color="#FF3D6087"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#0d345d" />
                </Border.Background>
                <ItemsPresenter/>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="CustomButtonTemplate" TargetType="Button">
            <Border x:Name="Border" BorderThickness="3" CornerRadius="10">
                <Border.BorderBrush>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF1E465B"/>
                            <GradientStop Offset="1" Color="#FF3D6087"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF3D6087"/>
                            <GradientStop Offset="1" Color="#FF002852"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush>
                                <GradientStopCollection>
                                    <GradientStop Offset="0" Color="#FFFFE0C0"/>
                                    <GradientStop Offset="1" Color="#FFFF8100"/>
                                </GradientStopCollection>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Border" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush>
                                <GradientStopCollection>
                                    <GradientStop Offset="1" Color="#FF002852"/>
                                </GradientStopCollection>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CheckboxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="AliceBlue"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="MicrosoftSansSerif"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Background="Transparent" BorderBrush="AliceBlue" BorderThickness="1" Width="16" Height="16">
                                <TextBlock x:Name="CheckGlyph" Text="x" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="AliceBlue"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource btnTablo_Click}" Executed="btnTablo_Click"/>
        <CommandBinding Command="{StaticResource btnOpen_Click}" Executed="btnOpen_Click"/>
        <CommandBinding Command="{StaticResource btnSave_Click}" Executed="btnSave_Click"/>
        <CommandBinding Command="{StaticResource btnGrid_Click}" Executed="btnGrid_Click"/>
        <CommandBinding Command="{StaticResource btnChT_Click}" Executed="btnChT_Click"/>
        <CommandBinding Command="{StaticResource btnChH_Click}" Executed="btnChH_Click"/>
        <CommandBinding Command="{StaticResource btnChP_Click}" Executed="btnChP_Click"/>
        <CommandBinding Command="{StaticResource btnChW_Click}" Executed="btnChW_Click"/>
        <CommandBinding Command="{StaticResource btnChOp_Click}" Executed="btnChOp_Click"/>
        <CommandBinding Command="{StaticResource btn_Click}" Executed="btn_Click"/>
        <CommandBinding Command="{StaticResource btnPrint_Click}" Executed="btnPrint_Click"/>
        <CommandBinding Command="{StaticResource btnVers_Click}" Executed="btnVers_Click"/>

        <CommandBinding Command="{StaticResource btnOk_Click}" Executed="btnOk_Click"/>
        <CommandBinding Command="{StaticResource btnSetOk_Click}" Executed="btnSetOk_Click"/>
        <CommandBinding Command="{StaticResource btnSetNavigationOk_Click}" Executed="btnSetNavigationOk_Click"/>

        <CommandBinding Command="{StaticResource btnSetPresModif_Click}" Executed="btnSetPresModif_Click"/>
        <CommandBinding Command="{StaticResource btnSetNavigation_Click}" Executed="btnSetNavigation_Click"/>
        <CommandBinding Command="{StaticResource btnApprovePresModif_Click}" Executed="btnApprovePresModif_Click"/>
        <CommandBinding Command="{StaticResource btnCancelPresModif_Click}" Executed="btnCancelPresModif_Click"/>

        <CommandBinding Command="{StaticResource btnDateFrom_Click}" Executed="btnDateFrom_Click"/>
        <CommandBinding Command="{StaticResource btnDateTo_Click}" Executed="btnDateTo_Click"/>

        <CommandBinding Command="{StaticResource btnlblDateFrom_Click}" Executed="btnlblDateFrom_Click"/>
        <CommandBinding Command="{StaticResource btnlblDateTo_Click}" Executed="btnlblDateTo_Click"/>

        <CommandBinding Command="{StaticResource btnApprove_Click}" Executed="btnApprove_Click"/>
        <CommandBinding Command="{StaticResource btnCancel_Click}" Executed="btnCancel_Click"/>
    </Window.CommandBindings>


    <Grid x:Name="grid" Background="#FF00283D">
        <RichTextBox x:Name="richTextBoxMessage" VerticalAlignment="Top" HorizontalAlignment="Left" Height="600" Width="750" FontSize="17" Foreground="AliceBlue" Background="Transparent" BorderThickness="0" Visibility="Hidden"/>
        <CustomControls:CustomWindPanel x:Name="_customWindPanel1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="750" Height="600" Visibility="Visible"/>

        <ItemsControl HorizontalAlignment="Right" Width="49">
