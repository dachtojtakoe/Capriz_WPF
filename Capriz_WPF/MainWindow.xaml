                <CustomControls:CustomButtonText BtnText="Навигация" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="20" CommandText="{StaticResource btnSetNavigation_Click}" Cursor="Hand" Width="100" Height="40"/>
            </Grid>
        </ItemsControl>

