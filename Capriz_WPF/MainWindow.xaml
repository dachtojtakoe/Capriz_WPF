                <TextBlock x:Name="lblDateFrom" TextAlignment="Left" Text="От:" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Center" FontSize="20" FontWeight="Bold"  Foreground="White"  Width="40" Height="30" FontFamily="Microsoft Sans Serif" Margin="0,0,125,0"/>
                <TextBlock x:Name="lblDateTo" TextAlignment="Left" Text="До:" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Center" FontSize="20" FontWeight="Bold"  Foreground="White"  Width="40" Height="30" FontFamily="Microsoft Sans Serif" Margin="340,0,0,0"/>
                <CustomControls:CustomButtonText x:Name="btnlblDateFrom" HorizontalAlignment="Center" Width="180" Height="34" VerticalAlignment="Center" BtnText="04.07.2024 15:35:33" Margin="90,0,5,7" CommandText="{StaticResource btnlblDateFrom_Click}" Cursor="Hand"/>
                <CustomControls:CustomButtonText x:Name="btnlblDateTo" HorizontalAlignment="Right" Width="180" Height="34" VerticalAlignment="Center" BtnText="04.07.2024 15:35:33" Margin="0,0,5,7" CommandText="{StaticResource btnlblDateTo_Click}" Cursor="Hand"/>
            </Grid>
