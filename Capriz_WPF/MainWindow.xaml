                <ItemsControl HorizontalAlignment="Center" Width="100" VerticalAlignment="Top"  Margin="0,30,0,0">
                    <CheckBox x:Name="DTVVCheck" Content="DTVV" Style="{StaticResource CheckboxStyle}"/>
