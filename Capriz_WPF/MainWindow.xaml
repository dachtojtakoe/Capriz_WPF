        <CustomControls:CustomToolTip x:Name="CustomToolTip3" ToolTipText="Сохранение данных&#x0d;на USB накопитель" Margin="0,101,54,0" ToolTipWidth ="130" ToolTipHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip4" ToolTipText="Отображение данных&#x0d;в табличном виде" Margin="0,151,54,0" ToolTipWidth ="137" ToolTipHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip5" ToolTipText="График&#x0d;температуры&#x0d;воздуха" Margin="0,201,54,0" ToolTipWidth ="90" ToolTipHeight="60" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip6" ToolTipText="График&#x0d;влажности&#x0d;воздуха" Margin="0,251,54,0" ToolTipWidth ="80" ToolTipHeight="60" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip7" ToolTipText="График&#x0d;атмосферного&#x0d;давления" Margin="0,301,54,0" ToolTipWidth ="100" ToolTipHeight="60" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip8" ToolTipText="График&#x0d;скорости&#x0d;ветра" Margin="0,351,54,0" ToolTipWidth ="70" ToolTipHeight="60" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
        <CustomControls:CustomToolTip x:Name="CustomToolTip9" ToolTipText="График&#x0d;метеорологической&#x0d;видимости" Margin="0,401,54,0" ToolTipWidth ="125" ToolTipHeight="60" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>
