        <CustomControls:CustomToolTip x:Name="CustomToolTip12" ToolTipText="Версия&#x0d;программы" Margin="0,546,54,0" ToolTipWidth ="80" ToolTipHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" Panel.ZIndex="10"/>

        <ItemsControl x:Name="panelInformation" HorizontalAlignment="Center" VerticalAlignment="Center" Template="{StaticResource ItemsControlTemplate}" Height="220" Width="350" Visibility="Hidden">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="214">
                <TextBlock x:Name="lblText" TextAlignment="Left" Text="Имя файла" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Top" FontSize="14pt" Foreground="White" FontWeight="Bold" Width="319" Height="130" FontFamily="Microsoft Sans Serif" Margin="0,30,0,0"/>
                <CustomControls:CustomButtonText HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="10,10" CommandText="{StaticResource btnOk_Click}" Cursor="Hand" Width="50" Height="40"/>
            </Grid>
        </ItemsControl>

        <ItemsControl x:Name="dateTimePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Template="{StaticResource ItemsControlTemplate}" Height="300" Width="350" Visibility="Hidden">
