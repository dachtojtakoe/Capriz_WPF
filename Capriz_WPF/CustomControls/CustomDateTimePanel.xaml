<UserControl x:Class="Capriz_WPF.CustomControls.CustomDateTimePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:CustomControls="clr-namespace:Capriz_WPF.CustomControls"
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ControlTemplate x:Key="ItemsControlTemplate">
            <Border BorderThickness="3" CornerRadius="10" Margin="0,1,0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF1E465B"/>
                            <GradientStop Offset="1" Color="#FF3D6087"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStopCollection>
                            <GradientStop Offset="0" Color="#FF3D6087"/>
                            <GradientStop Offset="1" Color="#FF002852"/>
                        </GradientStopCollection>
                    </LinearGradientBrush>
                </Border.Background>
                <ItemsPresenter/>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid>
        <ItemsControl x:Name="panelInformation" HorizontalAlignment="Center" VerticalAlignment="Center" Template="{StaticResource ItemsControlTemplate}" Height="220" Width="350" Visibility="Visible">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="214">
                <TextBlock x:Name="lblText" TextAlignment="Left" Text="Имя файла" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Top" FontSize="14pt" Foreground="White" FontWeight="Bold" Width="319" Height="100" FontFamily="Microsoft Sans Serif" Margin="0,30,0,0"/>
                <CustomControls:CustomButtonText HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="10,10" Cursor="Hand"/>
            </Grid>
        </ItemsControl>
    </Grid>
</UserControl>
