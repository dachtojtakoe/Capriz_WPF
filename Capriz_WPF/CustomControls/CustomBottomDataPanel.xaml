<UserControl x:Class="Capriz_WPF.CustomControls.CustomBottomDataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="985" Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="CommonTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="AliceBlue"/>
            <Setter Property="FontSize" Value="13pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NoDataTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontSize" Value="19pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
        </Style>

        <Style x:Key="CustomToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#8292a9"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="16pt"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="3">
            <Rectangle.Stroke>
                <LinearGradientBrush>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#FF1E465B"/>
                        <GradientStop Offset="1" Color="#FF3D6087"/>
                    </GradientStopCollection>
                </LinearGradientBrush>
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <LinearGradientBrush>
                    <GradientStopCollection>
                        <GradientStop Offset="0" Color="#FF3D6087"/>
                        <GradientStop Offset="1" Color="#FF002852"/>
                    </GradientStopCollection>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--<StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" TextWrapping="Wrap" Text="Дата" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock x:Name="DataDate" Style="{StaticResource NoDataTextBlock}" Cursor="Hand" TextWrapping="Wrap" Text="XX.XX.XX" HorizontalAlignment="Left" Margin="10,0,0,0" MouseDown="DataTime_MouseDown"/>

            <TextBlock Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Время" VerticalAlignment="Center" Margin="30,0,0,0"/>
            <TextBlock x:Name="DataTime" Style="{StaticResource NoDataTextBlock}" Cursor="Hand" HorizontalAlignment="Left" TextWrapping="Wrap" Text="XX:XX:XX" Margin="10,0,0,0" MouseDown="DataTime_MouseDown"/>
        </StackPanel>-->

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!--<TextBlock Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Состояние" VerticalAlignment="Center" Margin="0,0,10,0"/>-->
            <Ellipse x:Name="DataSost" Width="45" Height="45" Stroke="AliceBlue" StrokeThickness="5" HorizontalAlignment="Right" MouseDown="DataSost_MouseDown" MouseEnter="DataSost_MouseEnter" MouseLeave="DataSost_MouseLeave" Cursor="Hand" Margin="0,0,0,0"/>
        </StackPanel>

        <Popup x:Name="CustomToolTipPopup" Width="166" Height="40" PlacementRectangle="-126,-44,0,0" Placement="Relative" PlacementTarget="{Binding ElementName=DataSost}" IsOpen="False" AllowsTransparency="True">
            <local:CustomToolTip x:Name="CustomToolTip1" ToolTipWidth="166" ToolTipHeight="40" ToolTipText="Нет данных с БПР-1" ToolTipTextForeground="red" ToolTipBorderColor="red" Visibility="Hidden"/>
        </Popup>
    </Grid>
</UserControl>