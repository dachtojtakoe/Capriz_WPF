                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <TextBlock Text="Курс, °" Style="{StaticResource LabelTextBlockAvg}"/>
                            <TextBlock Text="Н.Д." x:Name="DataCurs" Style="{StaticResource NoDataTextBlockAvg}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Скорость, уз" Style="{StaticResource LabelTextBlockAvg}"/>
                            <TextBlock Text="Н.Д." x:Name="DataSpeed" Style="{StaticResource NoDataTextBlockAvg}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="4" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <TextBlock Text="Широта" Style="{StaticResource LabelTextBlockAvg}"/>
                            <TextBlock Text="Н.Д." x:Name="DataLat" Style="{StaticResource NoDataTextBlockAvg}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Долгота" Style="{StaticResource LabelTextBlockAvg}"/>
                            <TextBlock Text="Н.Д." x:Name="DataLon" Style="{StaticResource NoDataTextBlockAvg}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="20,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <TextBlock Style="{StaticResource LabelTextBlockAvg}" HorizontalAlignment="Right" TextWrapping="Wrap" Text="Дата" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DataDate" Style="{StaticResource NoDataTextBlockAvg}" Cursor="Hand" TextWrapping="Wrap" Text="XX.XX.XX" HorizontalAlignment="Left" Margin="10,0,0,0" MouseDown="DataTime_MouseDown"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource LabelTextBlockAvg}" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Время" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DataTime" Style="{StaticResource NoDataTextBlockAvg}" Cursor="Hand" HorizontalAlignment="Left" TextWrapping="Wrap" Text="XX:XX:XX" Margin="10,0,0,0" MouseDown="DataTime_MouseDown"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>

            <Grid Grid.Column="2" Grid.RowSpan="3">
                <local:CustomDataPanel x:Name="customDataPanel" MouseDown="SPBU_MouseLeftButtonDown" />
                <TextBlock x:Name="ClicksTextBox" Foreground="AliceBlue" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="30" FontSize="14pt"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
