<UserControl x:Class="Capriz_WPF.CustomControls.CustomWindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="NoDataTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontSize" Value="15pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
        </Style>

        <Style x:Key="NoDataTextBlockAvg" TargetType="TextBlock" BasedOn="{StaticResource NoDataTextBlock}">
            <Setter Property="FontSize" Value="16pt"/>
        </Style>

        <Style x:Key="NoDataTextBlockBig" TargetType="TextBlock" BasedOn="{StaticResource NoDataTextBlock}">
            <Setter Property="FontSize" Value="22pt"/>
        </Style>

        <Style x:Key="LabelTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
        </Style>

        <Style x:Key="LabelTextBlockAvg" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="FontSize" Value="16pt"/>
        </Style>

        <Style x:Key="LabelTextBlockBig" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="FontSize" Value="16pt"/>
        </Style>

        <Style x:Key="CustomComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="AliceBlue"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                            BorderThickness="3"
                            CornerRadius="10"
                                     Opacity="0.8">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#0a365e"/>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <SolidColorBrush Color="#0c3d6a"/>
                                </Border.Background>
                            </Border>

                            <!-- ВЫБРАННЫЙ ПУНКТ — единственный ContentPresenter -->
                            <ContentPresenter x:Name="SelectionPresenter"
                                      Margin="20,0,50,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      IsHitTestVisible="False"/>

                            <!-- Стрелка -->
                            <Path HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"
                          Data="M 0,0 L 6,6 L 12,0"
                          Stroke="AliceBlue"
                          StrokeThickness="2.5"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          IsHitTestVisible="False"/>

                            <!-- Невидимая кнопка для открытия списка -->
                            <ToggleButton Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent},
                                          Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Выпадающий список -->
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,4,0,0"
                                BorderThickness="3"
                                CornerRadius="10">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush>
                                            <GradientStopCollection>
                                                <GradientStop Offset="0" Color="#FF1E465B"/>
                                                <GradientStop Offset="1" Color="#FF3D6087"/>
                                            </GradientStopCollection>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <SolidColorBrush Color="#0d345d"/>
                                    </Border.Background>
                                    <ScrollViewer Margin="2">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль элементов списка -->
        <Style x:Key="CustomComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="AliceBlue"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF3D6087"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF005A9E"/>
                                <Setter Property="Foreground" Value="Orange"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <RoutedCommand x:Key="SetInstantData"/>

    </UserControl.Resources>

