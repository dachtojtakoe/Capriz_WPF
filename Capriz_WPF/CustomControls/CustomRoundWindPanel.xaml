<UserControl x:Class="Capriz_WPF.CustomControls.CustomRoundWindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="490" d:DesignWidth="490">

    <UserControl.Resources>
        <x:Array x:Key="Angles" Type="sys:Double">
            <sys:Double>0</sys:Double>
            <sys:Double>30</sys:Double>
            <sys:Double>60</sys:Double>
            <sys:Double>90</sys:Double>
            <sys:Double>120</sys:Double>
            <sys:Double>150</sys:Double>
            <sys:Double>180</sys:Double>
            <sys:Double>210</sys:Double>
            <sys:Double>240</sys:Double>
            <sys:Double>270</sys:Double>
            <sys:Double>300</sys:Double>
            <sys:Double>330</sys:Double>
            <!-- Добавьте больше углов по необходимости -->
        </x:Array>

        <x:Array x:Key="MoreAngles" Type="sys:Double">
            <sys:Double>0</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>20</sys:Double>
            <sys:Double>30</sys:Double>
            <sys:Double>40</sys:Double>
            <sys:Double>50</sys:Double>
            <sys:Double>60</sys:Double>
            <sys:Double>70</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>90</sys:Double>
            <sys:Double>100</sys:Double>
            <sys:Double>110</sys:Double>
            <sys:Double>120</sys:Double>
            <sys:Double>130</sys:Double>
            <sys:Double>140</sys:Double>
            <sys:Double>150</sys:Double>
            <sys:Double>160</sys:Double>
            <sys:Double>170</sys:Double>
            <sys:Double>180</sys:Double>
            <sys:Double>190</sys:Double>
            <sys:Double>200</sys:Double>
            <sys:Double>210</sys:Double>
            <sys:Double>220</sys:Double>
            <sys:Double>230</sys:Double>
            <sys:Double>240</sys:Double>
            <sys:Double>250</sys:Double>
            <sys:Double>260</sys:Double>
            <sys:Double>270</sys:Double>
            <sys:Double>280</sys:Double>
            <sys:Double>290</sys:Double>
            <sys:Double>300</sys:Double>
            <sys:Double>310</sys:Double>
            <sys:Double>320</sys:Double>
            <sys:Double>330</sys:Double>
            <sys:Double>340</sys:Double>
            <sys:Double>350</sys:Double>
            <!-- Добавьте больше углов по необходимости -->
        </x:Array>

        <Style x:Key="CommonTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="AliceBlue"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NoDataTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontSize" Value="19pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>

        </Style>
    </UserControl.Resources>


    <Grid>
        <Path Stroke="#58d758" StrokeThickness="18" Data="{Binding WindDirectionPath2}" Opacity="0.7" Panel.ZIndex="5">
            <Path.RenderTransform>
                <RotateTransform Angle="0" />
            </Path.RenderTransform>
        </Path>

        <Path Stroke="Green" StrokeThickness="17" Data="{Binding WindDirectionPath10}" Opacity="0.7" Panel.ZIndex="5">
            <Path.RenderTransform>
                <RotateTransform Angle="0" />
            </Path.RenderTransform>
        </Path>

        <Path Stroke="Red" StrokeThickness="3" Data="{Binding AverageLine2}" Panel.ZIndex="7">
            <Path.RenderTransform>
                <RotateTransform x:Name="AverageAngle2" Angle="0" CenterX="245" CenterY="245"/>
            </Path.RenderTransform>
        </Path>

        <Path Stroke="Red" StrokeThickness="3" Data="{Binding AverageLine10}" Panel.ZIndex="7">
            <Path.RenderTransform>
                <RotateTransform x:Name="AverageAngle10" Angle="0" CenterX="245" CenterY="245"/>
            </Path.RenderTransform>
        </Path>

        <Ellipse Width="383" Height="383" Stroke="AliceBlue" StrokeThickness="3"/>
        <Ellipse Width="343.5" Height="343.5" Stroke="AliceBlue" StrokeThickness="2"/>
        <Ellipse Width="305" Height="305" Stroke="AliceBlue" StrokeThickness="3"/>

        <Grid x:Name="TypicalAngles">
            <TextBlock Text="0" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0"/>
            <TextBlock Text="90" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,23,0"/>
            <TextBlock Text="180" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,23"/>
            <TextBlock Text="270" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>

            <TextBlock Text="30" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,126,0"/>
            <TextBlock Text="60" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,126,46,0"/>
            <TextBlock Text="120" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,126"/>
            <TextBlock Text="150" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,118,52"/>

            <TextBlock Text="210" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="118,0,0,52"/>
            <TextBlock Text="240" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,126"/>
            <TextBlock Text="300" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,126,0,0"/>
            <TextBlock Text="330" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,46,0,0"/>
        </Grid>

        <Grid x:Name="SplitAngles" Visibility="Collapsed">
            <TextBlock Text="0" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,17,0,0"/>
            <TextBlock Text="90" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0"/>
            <TextBlock Text="180" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
            <TextBlock Text="90" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>

            <TextBlock Text="30" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,95,0"/>
            <TextBlock Text="60" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,95,35,0"/>
            <TextBlock Text="120" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,95"/>
            <TextBlock Text="150" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,89,39"/>

            <TextBlock Text="150" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="89,0,0,39"/>
            <TextBlock Text="120" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,95"/>
            <TextBlock Text="60" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,95,0,0"/>
            <TextBlock Text="30" Style="{StaticResource CommonTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,35,0,0"/>
        </Grid>
        <TextBlock Text="{Binding ValueDir}" Margin="0,0,0,25" Style="{StaticResource NoDataTextBlock}" Panel.ZIndex="10" Background="#0d345d" />

        <Path Stroke="Orange" StrokeThickness="3">
            <Path.Data>
                <LineGeometry StartPoint="212.8,246" EndPoint="275.31,246"/>
            </Path.Data>
        </Path>

        <TextBlock Text="{Binding ValueSpeed}" Margin="0,25,0,0"  Style="{StaticResource NoDataTextBlock}" Panel.ZIndex="10" Background="#0d345d"/>



        <ItemsControl ItemsSource="{StaticResource Angles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path Stroke="AliceBlue" StrokeThickness="4">
                        <Path.Data>
                            <LineGeometry StartPoint="0,-191" EndPoint="0,-151"/>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform CenterX="0" CenterY="0" Angle="{Binding}"/>
                        </Path.RenderTransform>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <ItemsControl ItemsSource="{StaticResource MoreAngles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                       <Path Stroke="AliceBlue" StrokeThickness="1">
                        <Path.Data>
                            <LineGeometry StartPoint="0,-191" EndPoint="0,-151"/>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform CenterX="0" CenterY="0" Angle="{Binding}"/>
                        </Path.RenderTransform>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Stroke="AliceBlue" StrokeThickness="3" Data="M-33,-0 L0,-106 L33,0 L20,106 L-20,106  Z" RenderTransformOrigin="0,0">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ShipRotateTransform" Angle="0"/>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</UserControl>
