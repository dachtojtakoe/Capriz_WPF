<UserControl x:Class="Capriz_WPF.CustomControls.CustomWindDataNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="169" d:DesignWidth="738">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DataWindName1" Text="СКОРОСТЬ И НАПРАВЛЕНИЕ КАЖУЩЕГОСЯ ВЕТРА, м/с / °" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11.25pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" Width="319" Height="36" FontFamily="Microsoft Sans Serif"/>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="DataWindName2" Text="СКОРОСТЬ И НАПРАВЛЕНИЕ ИСТИННОГО ВЕТРА, м/с / °" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11.25pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" Width="319" Height="36" FontFamily="Microsoft Sans Serif"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblMin1" Text="Минимальная" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lblMid1" Text="Средняя" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lblMax1" Text="Максимальная" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>

            <TextBlock x:Name="lbl2min1" Grid.Row="1" Grid.Column="0" Text="2 мин" HorizontalAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lbl10min1" Grid.Row="2" Grid.Column="0" Text="10 мин" HorizontalAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>

            <TextBlock x:Name="Data2Min1"  Text="Н.Д." Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Min1" Text="Н.Д." Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data2Mid1"  Text="Н.Д." Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Mid1" Text="Н.Д." Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data2Max1"  Text="Н.Д." Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Max1" Text="Н.Д." Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblMin2" Text="Минимальная" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lblMid2" Text="Средняя" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lblMax2" Text="Максимальная" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>

            <TextBlock x:Name="lbl2min2" Text="2 мин" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="lbl10min2" Text="10 мин" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="9.75pt" Foreground="White" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>

            <TextBlock x:Name="Data2Min2" Text="Н.Д."  Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Min2" Text="Н.Д." Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center"  TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data2Mid2" Text="Н.Д."  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Mid2" Text="Н.Д." Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"  TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data2Max2" Text="Н.Д."  Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap"  VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
            <TextBlock x:Name="Data10Max2" Text="Н.Д." Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"  TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14.25pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center"  FontFamily="Microsoft Sans Serif"/>
        </Grid>

    </Grid>
</UserControl>
