<UserControl x:Class="Capriz_WPF.CustomControls.CustomWindDataNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="225" d:DesignWidth="980">
    <Grid Background="Transparent">

        <!-- Заголовки "СКОРОСТЬ ..." -->
        <TextBlock x:Name="DataWindName1" Text="СКОРОСТЬ КАЖУЩЕГОСЯ ВЕТРА, м/с" HorizontalAlignment="Left" Margin="61,35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="15pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" Width="424" Height="24" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="DataWindName2" Text="СКОРОСТЬ ИСТИННОГО ВЕТРА, м/с" HorizontalAlignment="Left" Margin="539,35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="15pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" Width="424" Height="24" FontFamily="Microsoft Sans Serif"/>

        <!-- Подписи "Минимальная", "Средняя", "Максимальная" (первая группа) -->
        <TextBlock x:Name="lblMin1" Text="Минимальная" HorizontalAlignment="Left" Margin="84,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lblMid1" Text="Средняя" HorizontalAlignment="Left" Margin="235,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lblMax1" Text="Максимальная" HorizontalAlignment="Left" Margin="335,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <!-- Подписи "Минимальная", "Средняя", "Максимальная" (вторая группа) -->
        <TextBlock x:Name="lblMin2" Text="Минимальная" HorizontalAlignment="Left" Margin="527,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lblMid2" Text="Средняя" HorizontalAlignment="Left" Margin="679,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lblMax2" Text="Максимальная" HorizontalAlignment="Left" Margin="779,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <!-- Подписи "2 мин" и "10 мин" (левая часть) -->
        <TextBlock x:Name="lbl2min1" Text="2 мин" HorizontalAlignment="Left" Margin="28,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lbl10min1" Text="10 мин" HorizontalAlignment="Left" Margin="17,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <!-- Подписи "2 мин" и "10 мин" (правая часть) -->
        <TextBlock x:Name="lbl2min2" Text="2 мин" HorizontalAlignment="Left" Margin="908,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="lbl10min2" Text="10 мин" HorizontalAlignment="Left" Margin="908,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="13pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <!-- Значения для первой группы (кажущийся ветер) -->
        <TextBlock x:Name="Data2Min1" Text="Н.Д." HorizontalAlignment="Left" Margin="124,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Min1" Text="Н.Д." HorizontalAlignment="Left" Margin="124,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data2Mid1" Text="Н.Д." HorizontalAlignment="Left" Margin="248,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Mid1" Text="Н.Д." HorizontalAlignment="Left" Margin="248,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data2Max1" Text="Н.Д." HorizontalAlignment="Left" Margin="372,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Max1" Text="Н.Д." HorizontalAlignment="Left" Margin="372,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <!-- Значения для второй группы (истинный ветер) -->
        <TextBlock x:Name="Data2Min2" Text="Н.Д." HorizontalAlignment="Left" Margin="563,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Min2" Text="Н.Д." HorizontalAlignment="Left" Margin="563,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data2Mid2" Text="Н.Д." HorizontalAlignment="Left" Margin="692,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Mid2" Text="Н.Д." HorizontalAlignment="Left" Margin="692,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data2Max2" Text="Н.Д." HorizontalAlignment="Left" Margin="815,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
        <TextBlock x:Name="Data10Max2" Text="Н.Д." HorizontalAlignment="Left" Margin="815,166,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="19pt" Foreground="Orange" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

    </Grid>
</UserControl>