<UserControl x:Class="Capriz_WPF.CustomControls.CustomWindDataSmall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="150">

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
           FontWeight="Bold" FontFamily="Microsoft Sans Serif"
           TextAlignment="Center"
           Foreground="{Binding Foreground, ElementName=root}">
            <Run x:Name="DataSpeed" Text="Н.Д." FontSize="22pt"/>
            <Run x:Name="DataSpeedLabel" Text="" FontSize="16pt"/>
        </TextBlock>

        <TextBlock x:Name="lbl" Grid.Row="1" Grid.Column="1" Text="{Binding Text, ElementName=root}" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12pt" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>

        <TextBlock x:Name="DataDir" Grid.Row="2" Grid.Column="1" Text="Н.Д." HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="22pt" Foreground="{Binding Foreground, ElementName=root}" FontWeight="Bold" TextAlignment="Center" FontFamily="Microsoft Sans Serif"/>
    </Grid>
</UserControl>
