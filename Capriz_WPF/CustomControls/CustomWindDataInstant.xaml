<UserControl x:Class="Capriz_WPF.CustomControls.CustomWindDataInstant"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="NoDataTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontSize" Value="19pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
        </Style>
        
        <Style x:Key="LabelTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="3">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#FF3D6087"/>
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <SolidColorBrush Color="#0c3d6a"/>
            </Rectangle.Fill>
        </Rectangle>
        
        <StackPanel Margin="10">
            <TextBlock Text="Скорость, м/с" Style="{StaticResource LabelTextBlock}"/>
            <TextBlock Text="Н.Д." x:Name="SpeedValue" Style="{StaticResource NoDataTextBlock}"/>
            <TextBlock Text="Направление, °" Style="{StaticResource LabelTextBlock}" Margin="0,10,0,0"/>
            <TextBlock Text="Н.Д." x:Name="DirectionValue" Style="{StaticResource NoDataTextBlock}"/>
        </StackPanel>
    </Grid>
</UserControl>
