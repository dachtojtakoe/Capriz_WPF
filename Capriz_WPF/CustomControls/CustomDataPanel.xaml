<UserControl x:Class="Capriz_WPF.CustomControls.CustomDataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" d:Width="250" d:Height="800">

    <UserControl.Resources>
        <Style x:Key="CellLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            
        </Style>

        <Style x:Key="CellValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Orange"/>
            <Setter Property="FontSize" Value="19pt"/>
            <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Text" Value="Н.Д."/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="3">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#FF3D6087"/>
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <SolidColorBrush Color="#0d345d"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="10,10,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!-- Пара 1 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 2 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 3 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 4 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 5 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 6 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Пара 7 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Пара 1: Температура | Влажность ===== -->
            <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Температура воздуха, °C"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
               Text="Влажность воздуха, %"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataTemp" Grid.Row="1" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataHum"  Grid.Row="1" Grid.Column="1" Style="{StaticResource CellValue}"/>

            <!-- ===== Пара 2: Давление мм рт.ст. | Давление гПа ===== -->
            <TextBlock Grid.Row="3" Grid.Column="0"
               Text="Атмосферное давление, мм рт. ст."
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1"
               Text="Атмосферное давление, гПа"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataPressMm"  Grid.Row="4" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataPressGPa" Grid.Row="4" Grid.Column="1" Style="{StaticResource CellValue}"/>

            <!-- ===== Пара 3: Барическая тенденция | Ход тенденции ===== -->
            <TextBlock Grid.Row="6" Grid.Column="0"
               Text="Барическая тенденция за 3 ч., гПа"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="6" Grid.Column="1"
               Text="Ход барической тенденции"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataBarT"  Grid.Row="7" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataTrend" Grid.Row="7" Grid.Column="1" Style="{StaticResource CellValue}"/>

            <!-- ===== Пара 4: Количество слоёв | НГО верхнего ===== -->
            <TextBlock Grid.Row="9" Grid.Column="0"
               Text="Количество слоёв облаков"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="9" Grid.Column="1"
               Text="НГО верхнего слоя, м"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataClouds" Grid.Row="10" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataNgo3"   Grid.Row="10" Grid.Column="1" Style="{StaticResource CellValue}"/>

            <!-- ===== Пара 5: НГО среднего | НГО нижнего ===== -->
            <TextBlock Grid.Row="12" Grid.Column="0"
               Text="НГО среднего слоя, м"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="12" Grid.Column="1"
               Text="НГО нижнего слоя, м"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataNgo2" Grid.Row="13" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataNgo1" Grid.Row="13" Grid.Column="1" Style="{StaticResource CellValue}"/>

            <!-- ===== Пара 6: МДВ 1 мин | МДВ 10 мин ===== -->
            <TextBlock Grid.Row="15" Grid.Column="0"
               Text="Метеорологическая дальность видимости за 1 мин, м"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="15" Grid.Column="1"
               Text="Метеорологическая дальность видимости за 10 мин, м"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataDMDV1"  Grid.Row="16" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataDMDV10" Grid.Row="16" Grid.Column="1" Style="{StaticResource CellValue}"/>
            
            <TextBlock Grid.Row="18" Grid.Column="0"
               Text="Параметр волнения Hm0, см"
               Style="{StaticResource CellLabel}"/>
            <TextBlock Grid.Row="18" Grid.Column="1"
               Text="Параметр волнения Hmax, см"
               Style="{StaticResource CellLabel}"/>
            <TextBlock x:Name="DataHm0" Grid.Row="19" Grid.Column="0" Style="{StaticResource CellValue}"/>
            <TextBlock x:Name="DataHmax" Grid.Row="19" Grid.Column="1" Style="{StaticResource CellValue}"/>

        </Grid>
    </Grid>
</UserControl>