<UserControl x:Class="Capriz_WPF.CustomControls.CustomToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d">


    <Grid  Width="{Binding ToolTipWidth}" MinHeight="30" MinWidth="30" Height="{Binding ToolTipHeight}">
        <Border CornerRadius="10" Background="#8292a9" BorderBrush="{Binding ToolTipBorderColor}" BorderThickness="1">
            <TextBlock  Text="{Binding ToolTipText}" Padding="5" FontSize="16" Foreground = "{Binding ToolTipTextForeground}" />
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="black" Opacity="0.7"/>
            </Border.Effect>
        </Border>
    </Grid>
    
</UserControl>
 