<UserControl x:Class="Capriz_WPF.CustomControls.CustomAdditionalDataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capriz_WPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="232.75" d:DesignWidth="986.86">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13pt" Foreground="White" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif">
                    <Run Text="Количество  "/><LineBreak/><Run Text="осадков, мм/ч"/>
                </TextBlock>
                <TextBlock x:Name="DataPrecip" TextAlignment="Center"
                           FontSize="19pt" Foreground="Orange" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif" Text="Н.Д."/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13pt" Foreground="White" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif">
                    <Run Text="Параметр  "/><LineBreak/><Run Text="волнения Hm0, см"/>
                </TextBlock>
                <TextBlock x:Name="DataHm0" TextAlignment="Center"
                           FontSize="19pt" Foreground="Orange" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif" Text="Н.Д."/>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13pt" Foreground="White" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif">
                    <Run Text="Параметр  "/><LineBreak/><Run Text="волнения Hmax, см"/>
                </TextBlock>
                <TextBlock x:Name="DataHmax" TextAlignment="Center"
                           FontSize="19pt" Foreground="Orange" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif" Text="Н.Д."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13pt" Foreground="White" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif">
                    <Run Text="Широта  "/><LineBreak/><Run Text="места"/>
                </TextBlock>
                <TextBlock x:Name="DataLat" TextAlignment="Center"
                           FontSize="19pt" Foreground="Orange" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif" Text="Н.Д."/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13pt" Foreground="White" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif">
                    <Run Text="Долгота  "/><LineBreak/><Run Text="места"/>
                </TextBlock>
                <TextBlock x:Name="DataLon" TextAlignment="Center"
                           FontSize="19pt" Foreground="Orange" FontWeight="Bold"
                           FontFamily="Microsoft Sans Serif" Text="Н.Д."/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>