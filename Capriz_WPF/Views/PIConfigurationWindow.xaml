<Window x:Class="Capriz_WPF.Views.PIConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capriz_WPF.Views"
        xmlns:cc="clr-namespace:Capriz_WPF.CustomControls"

        mc:Ignorable="d"
        Title="Конфигуратор ПИ" Height="400" Width="700" FontSize="20">

    <Window.Resources>
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20px"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextBlockStyleRX" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="Foreground" Value="Blue"/>
        </Style>

        <Style x:Key="TextBlockStyleTX" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="Foreground" Value="Red"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Ветер" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ComboBox x:Name="windTypeCombo"
                      Margin="6,0,0,0" SelectedIndex="0">
                    <!--Style="{StaticResource CustomComboBox}"
                      ItemContainerStyle="{StaticResource CustomComboBoxItem}">-->
                    <ComboBoxItem Content="истинный"/>
                    <ComboBoxItem Content="кажущийся"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Осреднения" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ComboBox x:Name="windAverageCombo"
                      Margin="6,0,0,0" SelectedIndex="0">
                    <!--Style="{StaticResource CustomComboBox}"
                      ItemContainerStyle="{StaticResource CustomComboBoxItem}">-->
                    <ComboBoxItem Content="мгновенные"/>
                    <ComboBoxItem Content="за 2 минуты"/>
                    <ComboBoxItem Content="за 10 минут"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Порт ПИ" Style="{StaticResource TextBlockStyle}"/>
                <TextBlock Text="Скорость" Grid.Column="1" Style="{StaticResource TextBlockStyle}"/>
                <TextBlock Text="VTG" Grid.Column="2" Style="{StaticResource TextBlockStyleRX}"/>
                <TextBlock Text="VHW" Grid.Column="3" Style="{StaticResource TextBlockStyleRX}"/>
                <TextBlock Text="RMC" Grid.Column="4" Style="{StaticResource TextBlockStyleRX}"/>
                <TextBlock Text="VBW" Grid.Column="5" Style="{StaticResource TextBlockStyleRX}"/>
                <TextBlock Text="HDT" Grid.Column="6" Style="{StaticResource TextBlockStyleRX}"/>
                
                <TextBlock Text="ALB" Grid.Column="8" Style="{StaticResource TextBlockStyleTX}"/>
                <TextBlock Text="MWV" Grid.Column="9" Style="{StaticResource TextBlockStyleTX}"/>
                <TextBlock Text="XDR" Grid.Column="10" Style="{StaticResource TextBlockStyleTX}"/>
                <TextBlock Text="MWD" Grid.Column="11" Style="{StaticResource TextBlockStyleTX}"/>
            </Grid>

            <cc:PortSettingsRow Grid.Row="1" x:Name="rowX8" PortName="X8(232)"/>
            <cc:PortSettingsRow Grid.Row="2" x:Name="rowX4" PortName="X4(Eth)"/>
            <cc:PortSettingsRow Grid.Row="3" x:Name="rowX2" PortName="X2"/>
            <cc:PortSettingsRow Grid.Row="4" x:Name="rowX3" PortName="X3"/>
            <cc:PortSettingsRow Grid.Row="5" x:Name="rowX5" PortName="X5"/>
            <cc:PortSettingsRow Grid.Row="6" x:Name="rowX6" PortName="X6"/>
            <cc:PortSettingsRow Grid.Row="7" x:Name="rowX7" PortName="X7"/>

        </Grid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="WriteConfigurationBtn" Content="Записать" Click="WriteConfigurationBtn_Click" Style="{StaticResource ButtonStyle}"/>
            <Button Grid.Column="1" x:Name="ReadConfigurationBtn" Content="Прочитать" Click="ReadConfigurationBtn_Click" Style="{StaticResource ButtonStyle}"/>
            <Button Grid.Column="2" x:Name="EscapeBtn" Content="Выход" Click="EscapeBtn_Click" Style="{StaticResource ButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
